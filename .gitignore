# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ---------------------------------------------------------------------------
# Xcode — user-specific state
#
# xcuserdata holds per-developer breakpoints, window layout, and scheme state.
# Schemes you want to share belong in xcshareddata/ (NOT ignored) — that is
# where `xcodebuild -scheme` looks, so CI needs them.
# ---------------------------------------------------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Legacy Xcode 3 / 4 per-user project files
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ---------------------------------------------------------------------------
# Xcode — build products and derived artifacts
#
# These normally live in ~/Library/Developer/Xcode/DerivedData, but are listed
# in case the location is overridden to a repo-local path. The `**/` prefixes
# keep them from matching a real source directory deeper in the tree.
# ---------------------------------------------------------------------------
build/
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcresult
*.moved-aside

# ---------------------------------------------------------------------------
# Swift Package Manager
#
# Package.resolved is deliberately NOT ignored: for an app it pins resolved
# dependency versions and belongs in source control. Uncomment the entries
# below only if this ever becomes a library that should not lock versions.
# ---------------------------------------------------------------------------
.swiftpm/
.build/
# Packages/
# Package.resolved

# ---------------------------------------------------------------------------
# Dependency managers
#
# Pods/ and Carthage/Checkouts are commented out rather than ignored: whether
# to vendor dependencies is a project decision. Uncomment if you adopt them
# and choose not to check them in. There are no such dependencies today.
# ---------------------------------------------------------------------------
# Pods/
# Carthage/Checkouts
Carthage/Build/

# ---------------------------------------------------------------------------
# Fastlane
# ---------------------------------------------------------------------------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ---------------------------------------------------------------------------
# Injection / hot reload tooling
# ---------------------------------------------------------------------------
iOSInjectionProject/

# ---------------------------------------------------------------------------
# Claude Code — linked git worktrees
#
# A session isolated in a worktree puts it under .claude/worktrees/, INSIDE this
# checkout. Git does not ignore linked worktrees on its own, so without this the
# whole second copy of the project shows up as untracked — and `git add -A`
# turns it into an embedded-repository entry pointing at that copy, which is a
# confusing thing to find committed.
#
# Scoped to worktrees/ rather than .claude/ wholesale: project-shared settings
# and agent definitions live alongside it and are meant to be committable.
# ---------------------------------------------------------------------------
.claude/worktrees/
